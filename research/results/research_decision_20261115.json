  "groups": {
    "features": {
      "title": "Khảo sát đặc trưng và chuẩn hóa",
      "protocol": "Bộ tự thu, 3 vòng ngoài; tổng 297 genuine/600 impostor.",
      "conclusion": "Chọn qua vòng trong không cải thiện đồng thời FAR/FRR so baseline hiệu chỉnh; dữ liệu đã xem."
    },
    "enrollment": {
      "title": "Chất lượng enrollment và chuẩn hóa",
      "protocol": "Cùng bộ tự thu; 6 phương án, chọn qua vòng trong.",
      "conclusion": "Giảm FRR nhưng tăng FAR; không thay cấu hình chính."
    },
    "stability": {
      "title": "Trọng số mềm qua 10 cách chia",
      "protocol": "Trung bình 10 cách chia trên cùng 15 mã; không phải 150 người.",
      "conclusion": "Soft có FAR/FRR trung bình thấp hơn baseline; SD theo cách chia không phải CI, không bảo đảm chuyển nguồn."
    },
    "cmu_sessions": {
      "title": "Thích nghi CMU qua 8 phiên",
      "protocol": "Pooled 5.700 genuine/16.800 impostor, lịch checkpoint cũ.",
      "conclusion": "Decay giảm hai lỗi so window trong phép thử này; không so trực tiếp với lịch probe phiên 2 bên dưới."
    },
    "external": {
      "title": "Kiểm chứng KeyRecs cố định hồ sơ",
      "protocol": "3.301 genuine/10.560 impostor, 47 chiều; phương pháp khóa trước lượt chấm đầu.",
      "conclusion": "Soft giảm 5 nhận nhầm và 7 genuine bị từ chối; lợi ích nhỏ, FRR còn khoảng 74%, không có suy luận thống kê mới."
    },
    "matched": {
      "title": "Đối chứng thích nghi cùng điều kiện",
      "protocol": "CMU và KeyRecs: cùng lịch phiên 2; mỗi nhánh hiệu chỉnh riêng trên dev FAR 5%.",
      "conclusion": "CMU thuận lợi mô tả; KeyRecs giảm FRR nhưng tăng FAR. Không ủng hộ nhất quán cả hai nguồn."
    },
    "cv": {
      "title": "Chỉ thay quy tắc tổng hợp CV",
      "protocol": "Cùng detector decay20, điểm OOF và ngưỡng z baseline; không phải cùng FAR dev.",
      "conclusion": "CMU đánh đổi FAR–FRR; KeyRecs cả hai lỗi tăng. Cả hai nguồn không đạt giả thuyết đã định."
    },
    "mad_shrink": {
      "title": "Co MAD về prior DEV (shrink25)",
      "protocol": "Hồ sơ tĩnh20, CV5fold; cùng ngân sách FAR DEV5%; CMU/KeyRecs đã xem.",
      "conclusion": "Không nguồn nào đạt tiêu chí. CMU cả hai lỗi tăng; KeyRecs giảm FRR nhưng tăng FAR."
    },
    "greyc_fixed": {
      "title": "Kiểm chứng shrink25 cố định trên GREYC-Web",
      "protocol": "42DEV/21TEST, 21 timing nguồn; ngưỡng riêng từng nhánh theo DEV5%. Phương pháp/tiêu chí khóa trước scoring nguồn mới.",
      "conclusion": "FAR và FRR macro đều tăng;3/21 mã được lợi có guard. Không đạt. GREYC đã được xem sau lượt này."
    },
    "percentile": {
      "title": "Phân vị OOF thay mean/SD",
      "protocol": "28calibration/14evaluation từ42DEV đã xem; same detector/probe, cùng ngân sách FAR≤5%, không chia ties.",
      "conclusion": "FRR giảm nhưng FAR tăng;2/14 mã được lợi có guard. Không đạt; giữ kết quả bất lợi."
    },
    "covariance": {
      "title": "Giữ/bỏ off-diagonal covariance",
      "protocol": "28/14DEV, cùng LedoitWolf/mean/MAD/CV; full vs diag là chính, Manhattan chỉ tham chiếu.",
      "conclusion": "Full giảm FRR nhưng tăng FAR so diag;4/14 mã được lợi có guard. Cổng B không đạt; chưa chạy nguồn ngoài B."
    }
  },
