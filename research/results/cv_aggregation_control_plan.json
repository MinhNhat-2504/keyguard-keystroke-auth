{
  "schema_version": 1,
  "plan_id": "cv-aggregation-control-v1",
  "date": "2026-11-13",
  "status": "design_locked_only_no_new_runner_or_candidate_scores",
  "protocol_file": "docs/CV_AGGREGATION_CONTROL_PROTOCOL.md",
  "protocol_sha256": "876171feca856b9479026e3be76bac12361076291cb37adacd0fe09ac83fbe3a",
  "prior_exposure": "CMU, KeyRecs, matched results and p013 diagnostic informed the design; not fresh validation or public preregistration",
  "hypothesis": "Age-weighted OOF CV mean/population SD reduces macro FAR without increasing macro FRR relative to uniform OOF aggregation with identical decay20 detector and shared fixed per-source z threshold",
  "arms": {
    "baseline": "uniform_cv",
    "candidate": "age_weighted_cv"
  },
  "only_changed_rule": "joint center/scale aggregation of the same OOF score vector",
  "fixed": {
    "detector": "decay20",
    "window": 50,
    "detector_half_life_genuine_samples": 20,
    "cv_folds": 5,
    "fold_partition": "contiguous np.array_split on chronological history",
    "train_weights": "original history age weights restricted to train positions",
    "shared_detector_raw_scores_and_oof_vector": true,
    "aggregation_half_life_genuine_samples": 20,
    "scale_floor": 1e-06,
    "enrollment": 20,
    "threshold_selection": false,
    "threshold_rule": "use same saved decay20 threshold for both arms within source",
    "candidate_dev_far_may_differ_from_five_percent": true,
    "warmup": "remaining S1 oracle genuine; excluded from primary FRR",
    "test_genuine": "S2, score before oracle update regardless of either decision",
    "test_probes": "first5+last5 other test S2, once at S2 start; no update",
    "dev_probes": "first5+last5 other dev S1, once after20 enrollment, observational only",
    "dev_session2_use": false,
    "sessions_used": [
      1,
      2
    ]
  },
  "aggregation_formulas": {
    "age": "n-1-i, n=current past history size",
    "weights": "0.5 ** (age / 20)",
    "uniform_center": "sum(q)/n",
    "uniform_scale": "max(sqrt(sum((q-center)**2)/n),1e-6)",
    "weighted_center": "sum(w*q)/sum(w)",
    "weighted_scale": "max(sqrt(sum(w*(q-weighted_center)**2)/sum(w)),1e-6)",
    "bessel_or_effective_size_correction": false
  },
